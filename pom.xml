<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional Maven build. The project does not need Maven: it builds with the JDK alone through
  ke.ku.sco310.qr.tools.ProjectBuilder, which drives the JavaCompiler API and JarOutputStream.
  This file is supplied for teams that prefer a repository-managed build; the ZXing component
  stays optional at run time.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ke.ku.sco310</groupId>
  <artifactId>qr-component-suite</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>SCO310 QR Code Generator Component Suite</name>
  <description>Component-oriented QR Code generator built from interchangeable JavaBeans components.</description>

  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <main.class>ke.ku.sco310.qr.ui.QrStudioGuiAssembly</main.class>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>3.5.3</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>javase</artifactId>
      <version>3.5.3</version>
      <scope>test</scope>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src/main/java</sourceDirectory>
    <testSourceDirectory>src/test/java</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifestFile>manifest/MANIFEST.MF</manifestFile>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <release>11</release>
          <compilerArgs>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>${main.class}</mainClass>
        </configuration>
        <executions>
          <execution>
            <id>verification-suite</id>
            <phase>test</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>ke.ku.sco310.qr.test.VerificationRunner</mainClass>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>${project.build.directory}/qr-evidence</argument>
              </arguments>
              <systemProperties>
                <systemProperty>
                  <key>java.awt.headless</key>
                  <value>true</value>
                </systemProperty>
              </systemProperties>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
